# Synthetic local-only defaults. Copy to the repository root as .env before
# running Compose; POSTGRES_PASSWORD is required and has no Compose fallback.
POSTGRES_DB=fleet
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet-dev-only

# Optional seed clock. Omit to use the current UTC clock.
# FLEET_SEED_TIME=2026-10-03T12:00:00Z

# Separate synthetic observation source (not a read-triggered refresh).
FLEET_SYNTHETIC_OBSERVATIONS=1
FLEET_OBSERVATION_INTERVAL_SECONDS=10

# Fault controls are disabled by default. These settings take effect after
# restarting Fleet; probes and metrics remain available during fault runs.
FLEET_FAULT_LATENCY_MS=0
FLEET_FAULT_ERROR_PERCENT=0
FLEET_FAULT_CONTROL=0
