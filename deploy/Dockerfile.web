FROM node:24-alpine AS build
ARG BUILD_SERVICE=web
ARG BUILD_COMMIT=unknown
ARG BUILD_ARCH=unknown
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build
RUN node -e 'require("node:fs").writeFileSync("dist/buildinfo.json", JSON.stringify({service:process.env.BUILD_SERVICE,source_commit:process.env.BUILD_COMMIT,architecture:process.env.BUILD_ARCH})+"\n")'

FROM nginxinc/nginx-unprivileged:1.29-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --chmod=755 deploy/30-runtime-resolver.sh /docker-entrypoint.d/30-runtime-resolver.sh
COPY --chmod=755 deploy/40-runtime-config.sh /docker-entrypoint.d/40-runtime-config.sh
COPY --from=build /src/web/dist /usr/share/nginx/html
EXPOSE 8080
